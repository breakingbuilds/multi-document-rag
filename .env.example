# ============================================================================
# .env.example — copy this file to ".env" and fill in your own values.
# ----------------------------------------------------------------------------
# NEVER commit a real .env file. It is listed in .gitignore for that reason.
# Every variable below has a sensible default in src/config.py, so you only
# need to set the ones you want to change (plus at least one API key).
# ============================================================================

# ---------------------------------------------------------------------------
# LLM PROVIDER
# ---------------------------------------------------------------------------
# Which chat-completion provider to use by default. One of:
#   groq         -> Groq cloud (FREE tier, no credit card). Fast. Recommended.
#   huggingface  -> Hugging Face Inference Providers router (uses your HF token).
# Both can be overridden per run with:  python main.py --provider ... --model ...
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) -----------------------------------
# Create a free account, click "Create API Key", paste it here. New accounts are
# on the FREE PLAN: no charge, but rate-limited (30 requests/min, 8K tokens/min,
# 200K tokens/day per model). The prices shown on the models page apply only
# to the paid "Developer" plan.
GROQ_API_KEY=gsk_your_groq_key_here
# Free-plan chat models: openai/gpt-oss-120b | openai/gpt-oss-20b |
#                        qwen/qwen3.6-27b    | qwen/qwen3.8-27b
# (llama-3.3-70b-versatile / llama-3.1-8b-instant are Enterprise-only now.)
GROQ_MODEL=openai/gpt-oss-120b

# --- Hugging Face (https://huggingface.co/settings/tokens) ------------------
# A "Read" token is enough. Free accounts get a small monthly inference credit.
HF_TOKEN=hf_your_huggingface_token_here
# Any chat model served by the Inference Providers router.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Ollama (https://ollama.com/download) — runs models on THIS machine ------
# No key. Install Ollama, run `ollama pull llama3.2`, then `/provider ollama`.
# Only change the URL if Ollama runs elsewhere (another PC, another port).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# RAGAS EVALUATION (which LLM acts as the "judge")
# ---------------------------------------------------------------------------
# RAGAS makes many LLM calls per question, so the free Groq plan is the best
# choice. The 120B model parses the judge prompts more reliably than the 20B.
RAGAS_JUDGE_PROVIDER=groq
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# EMBEDDINGS (local sentence-transformers — free, runs on CPU)
# ---------------------------------------------------------------------------
# Options (see EMBEDDING_MODELS in src/config.py):
#   sentence-transformers/all-MiniLM-L6-v2   (384-dim, fastest, default)
#   sentence-transformers/all-mpnet-base-v2  (768-dim, higher quality)
#   BAAI/bge-small-en-v1.5                   (384-dim, strong retrieval)
#   BAAI/bge-base-en-v1.5                    (768-dim, stronger retrieval)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# VECTOR DATABASE
# ---------------------------------------------------------------------------
VECTOR_DB=chroma
# Folder where ChromaDB persists its collections (gitignored).
CHROMA_DIR=chroma_db

# ---------------------------------------------------------------------------
# CHUNKING + RETRIEVAL DEFAULTS
# ---------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Default query-rewriting strategy. One of:
#   none | manual_rrf | manual_centroid | llm_multi_query | llm_hyde |
#   llm_step_back | hybrid
QUERY_REWRITE_STRATEGY=manual_rrf
